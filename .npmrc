# pnpm 11 re-runs `pnpm install` before every `pnpm run`, which exits non-zero
# on the undecided optional `sharp` build script and blocks `pnpm dev`/`build`.
# We don't need that pre-run gate here.
verify-deps-before-run=false

# The private @cognisphere-sh/* packages are published to GitHub Packages, not
# npmjs.org. Without this, pnpm resolves the scope against the default registry
# and rejects the lockfile's github tarball URL (ERR_PNPM_TARBALL_URL_MISMATCH).
@cognisphere-sh:registry=https://npm.pkg.github.com
# NOTE: the auth token deliberately is NOT here. pnpm refuses to expand env-var
# credentials from a committed project .npmrc, so the //npm.pkg.github.com/:_authToken
# line must live in the run user's ~/.npmrc. setup-server.sh writes it there.
