node_modules
config
**/DS_Store
**/.secrets/**
scripts/aws/config
logs/

# python bytecode — build artifacts of the agent helper scripts, keyed to the
# path they were compiled at, so they go stale the moment a script moves.
__pycache__/
*.pyc

# agent workspaces
**/harness/agents/*/workspace/**

# webchat runtime state — the chat transcript, uploaded files and the agent's
# outbound copies. Session data, so it must never be committed (CLAUDE.md §6).
# Scoped to webchat on purpose: other plugins keep real config under state/
# (telegram's routes.json, scheduler's schedules.json), which stays tracked.
**/harness/agents/*/plugins/webchat/state/**
**/harness/agents/*/plugins/webchat/inbox/**

