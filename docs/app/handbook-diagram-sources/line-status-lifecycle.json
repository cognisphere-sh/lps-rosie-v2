{
  "schema_version": 3,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Plant Line Availability Status",
    "output": "line-status-lifecycle.html",
    "locale": "en",
    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "start": {
          "label": "Option recorded"
        },
        "waiting": {
          "label": "Waiting on supplier or stock"
        },
        "decision": {
          "label": "Status is decided here"
        },
        "success": {
          "label": "Can supply (all or part)"
        },
        "failure": {
          "label": "Cannot supply"
        },
        "neutral": {
          "label": "Alternative offered"
        }
      }
    }
  },
  "mainPath": [
    "added",
    "asked",
    "answered",
    "applied",
    "available"
  ],
  "states": [
    {
      "id": "added",
      "type": "start",
      "label": "Candidate added",
      "sublabel": "NULL · pill: Pending",
      "tag": "not on a sent AR",
      "step": "01"
    },
    {
      "id": "asked",
      "type": "waiting",
      "label": "Pending",
      "sublabel": "sent · pill: AR sent",
      "tag": "AR: NULL · line: pending",
      "step": "02"
    },
    {
      "id": "answered",
      "type": "decision",
      "label": "Supplier answers",
      "sublabel": "sets AR item status",
      "tag": "request: Processing",
      "step": "03"
    },
    {
      "id": "applied",
      "type": "decision",
      "label": "Job line shows it",
      "sublabel": "reads selected candidate",
      "tag": "live · nothing copied",
      "step": "04"
    },
    {
      "id": "available",
      "type": "success",
      "label": "Available",
      "sublabel": "line: available",
      "tag": "AR: available",
      "step": "05"
    },
    {
      "id": "partial",
      "type": "success",
      "label": "Partial Qty",
      "sublabel": "line: partial_qty",
      "tag": "AR: partial_qty"
    },
    {
      "id": "unavailable",
      "type": "failure",
      "label": "Unavailable",
      "sublabel": "line: unavailable",
      "tag": "AR: unavailable"
    },
    {
      "id": "diffsub",
      "type": "neutral",
      "label": "Diff Sz/Sub",
      "sublabel": "line: diff_size_sub",
      "tag": "AR: diff_size_sub"
    },
    {
      "id": "canorder",
      "type": "waiting",
      "label": "Can Order",
      "sublabel": "line: need_to_order",
      "tag": "AR: can_order"
    },
    {
      "id": "arriving",
      "type": "waiting",
      "label": "Arriving Soon",
      "sublabel": "line: arriving_soon",
      "tag": "AR: arriving_soon"
    }
  ],
  "transitions": [
    {
      "id": "t-send",
      "from": "added",
      "to": "asked",
      "label": "Chris OKs",
      "variant": "security"
    },
    {
      "id": "t-save",
      "from": "asked",
      "to": "answered",
      "label": "saved"
    },
    {
      "id": "t-submit",
      "from": "answered",
      "to": "applied",
      "label": "submit"
    },
    {
      "id": "t-available",
      "from": "applied",
      "to": "available",
      "label": "enough",
      "variant": "emphasis"
    },
    {
      "id": "t-back-pending",
      "from": "answered",
      "to": "asked",
      "label": "set to Pending",
      "note": "saves NULL, clears qty"
    },
    {
      "id": "t-select",
      "from": "added",
      "to": "applied",
      "label": "selected on the line",
      "note": "default starts selected, else Chris's pick"
    },
    {
      "id": "t-unselect",
      "from": "applied",
      "to": "added",
      "label": "unselected",
      "note": "line shows its default candidate",
      "variant": "dashed"
    },
    {
      "id": "t-partial",
      "from": "applied",
      "to": "partial",
      "label": "fewer than asked"
    },
    {
      "id": "t-unavailable",
      "from": "applied",
      "to": "unavailable",
      "label": "none",
      "variant": "security"
    },
    {
      "id": "t-diffsub",
      "from": "unavailable",
      "to": "diffsub",
      "label": "substitute offered",
      "note": "submit selects the substitute row"
    },
    {
      "id": "t-canorder",
      "from": "applied",
      "to": "canorder",
      "label": "can order"
    },
    {
      "id": "t-arriving",
      "from": "applied",
      "to": "arriving",
      "label": "coming soon"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "One status, two spellings",
      "items": [
        "Status is stored once, on the selected candidate; the job line reads it live as candidate_status",
        "Pending: candidate NULL, job line pending",
        "Can Order: candidate can_order, job line need_to_order",
        "Diff Sz/Sub: diff_size_sub on the candidate (usually the substitute), job line and order line",
        "Available, Partial Qty, Unavailable and Arriving Soon use the same word everywhere",
        "Order lines take the candidate's status with the same two renames",
        "Candidate pill on the job card: No price while unanswered and unpriced, else Pending until its AR is sent, then AR sent until answered"
      ]
    },
    {
      "dot": "violet",
      "title": "When a job line changes",
      "items": [
        "Chris OKs: nothing reaches a supplier until Chris approves sending the AR",
        "Nothing is copied: the line shows its selected candidate's size, price, quantity (capped at demand), status and customer note",
        "A saved answer updates the candidate at once; a new supplier reply clears LPS's customer-note override",
        "On submit, a selection answered Unavailable with a substitute switches to the substitute, and the supplier's other alternatives are hidden",
        "Only open Quote or Availability jobs switch on submit",
        "Unselecting or deleting the candidate returns the line to its default candidate; selecting a hidden one unhides it"
      ]
    },
    {
      "dot": "amber",
      "title": "Substitutes and overrides",
      "items": [
        "A substitute answer keeps the asked row Unavailable (quantity 0)",
        "The substitute is its own Diff Sz/Sub row on the same AR, at full demand unless the supplier gives a quantity",
        "A non-original candidate answered Available reads Available",
        "LPS status edits write the selected candidate; Diff Sz/Sub is stored as given, unless the row offers a live substitute",
        "An LPS status edit sets Avail: demand for Available, Can Order, Arriving Soon or Diff Sz/Sub, 0 for Unavailable, blank for Pending",
        "No promotion: a substitute never becomes the original request"
      ]
    }
  ]
}
