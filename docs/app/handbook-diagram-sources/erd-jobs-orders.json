  "cards": [
    {
      "dot": "cyan",
      "title": "How a job moves through these tables",
      "items": [
        "A customer request is a job (job_requests); each plant asked for is a job line (job_request_items).",
        "Each line gets one or more supplier options (candidates): the original ask plus alternatives.",
        "Options for one supplier are sent together on that job's availability request; the supplier answers each option.",
        "The chosen option fills the line; supplier orders and their lines are then allocated back to job lines."
      ]
    },
    {
      "dot": "amber",
      "title": "Rules the database enforces",
      "items": [
        "One availability request per job and supplier, enforced by an insert trigger; two older requests for the same job and supplier predate the rule and are kept.",
        "Availability requests cannot be deleted; candidates were called availability request items (AR items) before migration 0119.",
        "An allocation row is keyed by the pair (order line, job line) and carries the quantity allocated.",
        "public_token is unique and empty by default: a share link exists only while one is published."
      ]
    },
    {
      "dot": "slate",
      "title": "Links not drawn here",
      "items": [
        "rosie_thread_ref and daisy_thread_ref point at chat threads; inventory.source_id points at the uploaded price list.",
        "suppliers.head_branch_id points at the head branch row; candidates.offered_candidate_id points at a substitute option.",
        "A circle on a line end means that side may be empty (an optional link)."
      ]
    }
  ]
}
