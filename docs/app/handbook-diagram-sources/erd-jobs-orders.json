    "views": [
      {
        "id": "job",
        "label": "A job and its lines",
        "focus": [
          "customers",
          "job_requests",
          "job_request_items"
        ],
        "note": "A customer asks for plants; each plant asked for is one job line."
      },
      {
        "id": "asking",
        "label": "Asking suppliers",
        "focus": [
          "job_request_items",
          "candidates",
          "availability_requests",
          "suppliers",
          "inventory"
        ],
        "note": "Each line gets supplier options (candidates); options for one supplier are sent together on one availability request."
      },
      {
        "id": "ordering",
        "label": "Ordering",
        "focus": [
          "orders",
          "order_items",
          "order_item_job_request_items",
          "job_request_items",
          "suppliers"
        ],
        "note": "A supplier order has lines; the allocation table says how much of each order line goes to which job line."
      }
    ]
  },
