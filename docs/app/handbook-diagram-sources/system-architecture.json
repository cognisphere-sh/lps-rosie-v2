  "cards": [
    {
      "dot": "rose",
      "title": "Who can reach what",
      "items": [
        "The LPS team signs in and can see everything",
        "Supplier partners sign in and see only their own company's portal",
        "Public links open one availability request or order, with no sign-in",
        "Passwords stay with Supabase Auth; browsers hold only a session cookie"
      ]
    },
    {
      "dot": "cyan",
      "title": "How screens stay live",
      "items": [
        "Database changes flow into Supabase Realtime",
        "The app server turns them into short 'something changed' signals",
        "Browsers then re-fetch what they need; slow polling covers dropped connections"
      ]
    },
    {
      "dot": "emerald",
      "title": "The four agents",
      "items": [
        "Rosie: jobs, quotes, availability requests and orders",
        "Daisy: finds and onboards suppliers and loads their availability",
        "Lily: owner feedback and requirements, Telegram only",
        "Nova: app and agent changes, docs and deploys"
      ]
    },
    {
      "dot": "amber",
      "title": "Channels by agent",
      "items": [
        "Web chat: Rosie, Daisy and Nova",
        "Gmail: Rosie and Daisy; supplier events: Rosie only",
        "Telegram, scheduler and agent messaging: all four",
        "Rosie and Daisy use a SQL tool that cannot delete rows or change tables, and upload files to Storage"
      ]
    },
    {
      "dot": "slate",
      "title": "Not drawn",
      "items": [
        "nginx also serves the harness operator console on a second domain",
        "Google sign-in for Gmail returns through the app to the harness",
        "The settings page reaches the harness admin API through an allowlisted pass-through",
        "Backups cover files on the server; business data lives in Supabase"
      ]
    }
  ]
