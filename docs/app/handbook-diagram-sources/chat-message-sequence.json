  "cards": [
    {
      "dot": "cyan",
      "title": "Who you chat with",
      "items": [
        "The team chats with Daisy, Rosie and Nova in the side panel",
        "Rosie keeps one conversation per job (jr-<id>), supplier and customer; Daisy one per supplier",
        "Main is the general conversation, shared with Telegram's main route"
      ]
    },
    {
      "dot": "emerald",
      "title": "How the screen stays current",
      "items": [
        "The database tells the app server when a conversation changes",
        "The app server pushes a thread event (with a short preview for the bell) over one shared SSE connection; the panel then fetches the messages",
        "If the connection drops, polling catches up: 10 s in the panel, 15 s in the portal"
      ]
    },
    {
      "dot": "violet",
      "title": "Files and questionnaires",
      "items": [
        "Files, pasted images and voice notes upload before the message is sent",
        "The agent gets each file's path and reads or transcribes it",
        "Questionnaire cards ask one question at a time, always with a Something else box"
      ]
    },
    {
      "dot": "rose",
      "title": "Supplier privacy",
      "items": [
        "A supplier sees only their own messages and replies Rosie marks --portal",
        "The team's internal discussion on the same thread never reaches the portal",
        "The portal's live ping carries no preview text"
      ]
    }
  ]
}
