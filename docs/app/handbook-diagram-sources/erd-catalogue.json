{
  "schema_version": 1,
  "diagram_type": "erd",
  "meta": {
    "title": "Catalogue database: suppliers, plants and photos",
    "locale": "en",
    "output": "erd-catalogue.html",
    "quality_profile": "standard",
    "views": [
      {
        "id": "suppliers-view",
        "label": "Supplier companies",
        "focus": [
          "suppliers",
          "supplier_contacts",
          "contacts",
          "app_users"
        ],
        "note": "Every location is a suppliers row; head_branch_id names the company's head branch. Contacts and partner logins hang off it."
      },
      {
        "id": "catalogue-view",
        "label": "Plant catalogue",
        "focus": [
          "inventory",
          "inventory_sources",
          "plant_aliases",
          "suppliers"
        ],
        "note": "Each availability file becomes an inventory_sources row; its plants become inventory rows and its alternative names become aliases."
      },
      {
        "id": "photos-chat-view",
        "label": "Photos and chat",
        "focus": [
          "plant_photos",
          "threads",
          "thread_messages",
          "suppliers"
        ],
        "note": "Photos may name a supplier. Each supplier company has one Rosie and one Daisy chat thread, shared by all its locations."
      }
    ]
  },
