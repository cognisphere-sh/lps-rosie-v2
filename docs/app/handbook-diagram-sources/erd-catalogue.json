  "cards": [
    {
      "dot": "cyan",
      "title": "Companies and locations",
      "items": [
        "A multi-site supplier has one suppliers row per location; head_branch_id points each location at the company's head branch, and a head branch points at itself.",
        "A trigger keeps that link one level deep: a branch cannot point at another branch.",
        "is_lps_partner is set automatically while the company has at least one partner login."
      ]
    },
    {
      "dot": "emerald",
      "title": "How the catalogue fills",
      "items": [
        "Old rows are retired (is_active = false), never deleted; switching off a source file retires its plants.",
        "Triggers compose name and the search keys from common, botanical and cultivar names.",
        "size_std holds the standard container size, such as 5G, 4\" Pot, B&B or Bare Root."
      ]
    },
    {
      "dot": "amber",
      "title": "Searching by any name",
      "items": [
        "plant_aliases pairs two names for the same plant, so searching a common name also finds the botanical one.",
        "Duplicate and mirrored pairs are skipped; a retired pair blocks the match from coming back."
      ]
    },
    {
      "dot": "slate",
      "title": "Logins and files",
      "items": [
        "Passwords live in Supabase Auth; app_users.id is the Auth user id. Admins have no supplier, partners have exactly one.",
        "Photo files sit in a private storage bucket and are shown only through short-lived signed links.",
        "Columns marked derived are kept by triggers, not typed by people."
      ]
    }
  ]
}
