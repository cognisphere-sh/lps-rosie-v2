{
  "name": "daisy",
  "model": {
    "provider": "vercel-ai-gateway",
    "id": "anthropic/claude-sonnet-4.6",
    "thinkingLevel": "medium"
  },
  "threadIdStrategy": {
    "type": "plugin_channel"
  },
  "maxConcurrentSlots": 5,
  "maxAttempts": 3,
  "runtime": "subprocess",
  "subagentModel": {
    "provider": "vercel-ai-gateway",
    "id": "anthropic/claude-sonnet-4.6",
    "thinkingLevel": "medium"
  },
  "secretsSchema": {
    "type": "object",
    "properties": {
      "SUPABASE_PROJECT_ID": { "type": "string", "description": "Supabase project ref (e.g. xyeyiqchadfszewztnrf)." },
      "SUPABASE_SECRET_KEY": { "type": "string", "description": "Supabase secret key (sb_secret_*). Used by upload / sign-url over HTTP." },
      "SUPABASE_DB_PASSWORD": { "type": "string", "description": "Postgres password for the `query` (psql) script." },
      "SUPABASE_URL": { "type": "string", "description": "Project URL (https://<ref>.supabase.co)." }
    },
    "required": ["SUPABASE_PROJECT_ID", "SUPABASE_SECRET_KEY"]
  }
}
