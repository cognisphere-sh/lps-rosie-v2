#!/usr/bin/env python3
"""Add or replace one pointer line in workspace/index.md without reading the
whole file. The line for the same path is replaced; a new path is added
right under the title. Locked, so parallel threads are safe.

Example: index-add threads/jr-83/notes.md 'JR-83 Praetorian planting schedule; AR-47 published.'
"""
import argparse
import fcntl
from pathlib import Path
import sys

INDEX = Path(__file__).resolve().parents[4] / "workspace/index.md"


def upsert(relpath, summary):
    relpath, summary = relpath.strip().strip("`"), " ".join(summary.split())
    if not relpath or not summary or relpath.startswith(("/", "..")):
        raise ValueError("give a workspace-relative path and a summary")
    line = f"- `{relpath}` — {summary}"
    INDEX.parent.mkdir(parents=True, exist_ok=True)
    with open(INDEX, "a+", encoding="utf-8") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        handle.seek(0)
        lines = handle.read().splitlines() or ["# Workspace index", ""]
        marker = f"`{relpath}`"
        for index, existing in enumerate(lines):
            if existing.startswith("- ") and marker in existing.split(" — ")[0]:
                lines[index] = line
                action = "replaced"
                break
        else:
            at = 1
            while at < len(lines) and not lines[at].strip():
                at += 1
            lines.insert(at, line)
            action = "added"
        handle.seek(0)
        handle.truncate()
        handle.write("\n".join(lines) + "\n")
    return action


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("path", help="path relative to workspace/, e.g. threads/jr-83/notes.md")
    parser.add_argument("summary")
    args = parser.parse_args()
    try:
        print(f"{upsert(args.path, args.summary)} {args.path}")
    except (OSError, ValueError) as error:
        print(f"index-add: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
