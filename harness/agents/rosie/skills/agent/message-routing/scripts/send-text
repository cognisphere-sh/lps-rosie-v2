#!/usr/bin/env python3
"""Pass a UTF-8 text file literally to the existing messaging CLI. No retries."""
import argparse
from pathlib import Path
import subprocess
import sys


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--via', choices=['agent', 'webchat'], required=True)
    parser.add_argument('--text-file', type=Path, required=True)
    parser.add_argument('--thread-id', required=True)
    parser.add_argument('--to-agent')
    parser.add_argument('--subject')
    parser.add_argument('--silent', action='store_true')
    parser.add_argument('--portal', action='store_true')
    args = parser.parse_args(argv)
    if args.via == 'agent' and (not args.to_agent or args.portal):
        parser.error('agent requires --to-agent and does not accept --portal')
    if args.via == 'webchat' and (args.to_agent or args.subject is not None or args.silent):
        parser.error('webchat does not accept --to-agent, --subject or --silent')
    try:
        text = args.text_file.read_text(encoding='utf-8')
        if not text.strip() or '\0' in text:
            raise ValueError('text must be nonempty and contain no NUL bytes')
        root = Path(__file__).resolve().parents[4]
        if args.via == 'agent':
            command = ['bash', str(root / 'scripts/agent-msg/send'),
                       '--to-agent', args.to_agent, '--thread-id', args.thread_id,
                       '--message', text]
            if args.subject is not None:
                command += ['--subject', args.subject]
            if args.silent:
                command += ['--silent']
        else:
            command = ['bash', str(root / 'scripts/webchat/webchat-cli'), 'send',
                       '--thread-id', args.thread_id, '--text', text]
            if args.portal:
                command += ['--portal']
        return subprocess.run(command, cwd=root, shell=False, check=False).returncode
    except (OSError, ValueError) as error:
        print(f'send-text: {error}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
