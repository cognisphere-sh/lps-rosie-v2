#!/usr/bin/env python3
"""Print one availability request (AR) compactly: header, its job, and
every line (candidate) with its answer and job line. Read-only.

Example: ar-snapshot 45
"""
import argparse
import sys

from _db import cell, json_value, money

SQL = """
SELECT json_build_object(
 'ar', (SELECT row_to_json(a) FROM (
    SELECT ar.id, ar.supplier_id, s.name AS supplier, s.is_lps_partner AS partner,
           ar.status, ar.submitted_at, ar.share_customer_details AS share,
           ar.public_token IS NOT NULL AS public, ar.note_for_supplier
    FROM availability_requests ar JOIN suppliers s ON s.id = ar.supplier_id
    WHERE ar.id = {ar}) a),
 'jobs', (SELECT json_agg(j ORDER BY j.id) FROM (
    SELECT jr.id, jr.name, jr.status FROM availability_requests ar
    JOIN job_requests jr ON jr.id = ar.job_request_id
    WHERE ar.id = {ar}) j),
 'lines', (SELECT json_agg(l ORDER BY l.id) FROM (
    SELECT c.id, c.name, c.size, c.description, c.is_original AS orig, c.demanded_quantity AS qty, c.status,
           c.available_quantity AS avail, c.unit_price, c.mapped_inventory_id AS mapped,
           c.is_active, c.note_for_supplier, c.note_from_supplier,
           c.offered_candidate_id AS sub, c.offer_description IS NOT NULL AS typed,
           (SELECT min(o.id) FROM candidates o
            WHERE o.offered_candidate_id = c.id AND o.is_active) AS sub_for,
           i.job_request_id || '/' || c.job_request_item_id AS job_line,
           EXISTS (SELECT 1 FROM job_request_items s WHERE s.selected_candidate_id = c.id) AS selected
    FROM candidates c
    LEFT JOIN job_request_items i ON i.id = c.job_request_item_id
    WHERE c.availability_request_id = {ar}) l)
) AS j;
"""


def render(data):
    ar = data.get("ar")
    if not ar:
        return "No AR with that id."
    out = [f"AR-{ar['id']} | {ar['supplier']} (supplier {ar['supplier_id']}, "
           f"{'partner portal' if ar['partner'] else 'non-partner'}) | {ar['status']}"
           + f" | submitted {cell(ar['submitted_at'])} | share details {ar['share']}"
           + (" | public link" if ar["public"] else ""),
           f"  header note: {cell(ar['note_for_supplier'])}",
           "JOBS " + ", ".join(f"JR-{j['id']} {j['name']} ({j['status']})" for j in data.get("jobs") or []) ]
    # A substitute answer: the asked row is unavailable "→ sub N" (typed = a
    # placeholder to enrich); the substitute row is "sub for" the asked one.
    out.append("LINES  id | qty x size name [description] | answer | avail | price | mapped | job/item | selected | ask | reply")
    for l in data.get("lines") or []:
        sub = f" → sub {l['sub']}{' typed' if l['typed'] else ''}" if l["sub"] else ""
        sub += f" (sub for {l['sub_for']})" if l["sub_for"] else ""
        out.append(f"  {l['id']}{'' if l['is_active'] else ' (inactive)'} | {cell(l['qty'])} x {cell(l['size'])} "
                   f"{cell(l['name'])} [{cell(l['description'])}{', original' if l['orig'] else ''}] | {cell(l['status'])}{sub} | {cell(l['avail'])} | {money(l['unit_price'])} | "
                   f"{'yes' if l['mapped'] else '∅'} | {cell(l['job_line'])} | {'yes' if l['selected'] else 'no'} | "
                   f"{cell(l['note_for_supplier'], 80)} | {cell(l['note_from_supplier'], 80)}")
    return "\n".join(out)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("ar", type=int, help="availability_requests.id")
    args = parser.parse_args()
    if args.ar <= 0:
        parser.error("AR id must be positive")
    try:
        print(render(json_value(SQL.format(ar=args.ar)) or {}))
    except (RuntimeError, ValueError) as error:
        print(f"ar-snapshot: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
