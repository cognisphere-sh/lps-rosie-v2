{
  "name": "daisy",
  "description": "Supplier management and coordination agent for LPS — onboards new suppliers and keeps availability/inventory data current in Supabase. Reachable on the Telegram main thread and in the web app's chat panel, which route to the same thread.",
  "model": {
    "provider": "openai-codex",
    "id": "gpt-5.6-sol",
    "thinkingLevel": "medium"
  },
  "threadIdStrategy": {
    "type": "plugin_channel"
  },
  "maxConcurrentSlots": 20,
  "maxAttempts": 3,
  "runtime": "subprocess",
  "secretsSchema": {
    "type": "object",
    "properties": {
      "SUPABASE_PROJECT_ID": {
        "type": "string",
        "description": "Supabase project ref (e.g. xyeyiqchadfszewztnrf)."
      },
      "SUPABASE_SECRET_KEY": {
        "type": "string",
        "description": "Supabase secret key (sb_secret_*). Used by upload / sign-url over HTTP."
      },
      "SUPABASE_DB_PASSWORD": {
        "type": "string",
        "description": "Postgres password for the `query` (psql) script."
      },
      "SUPABASE_URL": {
        "type": "string",
        "description": "Project URL (https://<ref>.supabase.co)."
      }
    },
    "required": [
      "SUPABASE_PROJECT_ID",
      "SUPABASE_SECRET_KEY"
    ]
  }
}
