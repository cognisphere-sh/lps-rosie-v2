#!/usr/bin/env python3
"""match-candidates — for each parsed availability entry, pull the closest
existing inventory rows for that supplier so *you* can decide update vs insert.

This script does retrieval and ranking. It does NOT write anything, and its
`suggest` column is a sort aid, not a decision — read the candidates and choose.
See §4 of the skill for the decision rules.

Why it exists: matching on an exact key silently mis-files anything the supplier
renamed, respelled, or re-sized between drops. Instead this fetches the N nearest
rows by trigram similarity on the plant identity, with a size-agreement bonus, so
a near miss is visible rather than invented as a new row.

Usage
-----
  match-candidates --supplier <id> [--entries <file>] [options]

Entries arrive as a JSON array on stdin (or from --entries). One object per
parsed offering. Give it the **three name parts** you parsed under §2 —
`common_name`, `botanical_name`, `cultivar` (the cultivar/variety/trade name).
Everything else is optional and echoed back so you can compare without a second
lookup:

  [{"common_name": "Live Oak", "botanical_name": "Quercus virginiana",
    "size": "15 G", "unit_price": 48.00, "quantity": 120, "height": "6-8'"}, ...]

A pre-0040 entry that carries only a composed `name` still works: it is matched
whole, exactly as before. Give the parts when you have them — they are what
makes the cultivar check below possible.

Options
  --supplier <id>     supplier_id to search within (required)
  --entries <file>    read entries from a file instead of stdin
  --limit <n>         candidates per entry (default 5)
  --min-sim <f>       trigram floor on the identity key (default 0.25)
  --batch <n>         entries per SQL round trip (default 200)
  --format text|json  default text
  --plan <file>       also write a decision plan for `apply-plan` (see below)
  --include-inactive / --active-only
                      default includes inactive rows, so a plant the supplier
                      dropped and brought back is found rather than duplicated

Columns returned per candidate are deliberately narrow — id, name, cultivar,
size, size_std, price, quantity, the three dimensions, is_active. Notes are
excluded: they are long, and they are not what tells two offerings apart.

The cultivar is called out separately because sibling selections are the classic
trap: `Abies concolor [Blue Select]` and `Abies concolor [Candicans]` score
almost identically on the identity as a whole. Cultivars are compared as **sets**
— a row can name a cultivar and a trade name — so a candidate is marked
`CULTIVAR MISMATCH`, and excluded from the suggestion, when both sides name at
least one selection and they **share none**. `Wolff, Emperor 1` against `Wolff`
is a match; against `Candicans` it is not.

Plan mode (--plan FILE): writes {"supplier_id", "source_id": null, "rows": [...]}
with one row per entry: `update`/`reactivate` (id = the suggested candidate),
`insert`, or `review`. Every entry suggested as an insert is first searched
with `search_inventory` (common and botanical name, this supplier only); a hit
with the same size turns it into `review` with the hits listed, otherwise it is
marked `"searched": true`. Entry fields map to columns (`cultivar` →
`cultivar_variety_trade_name`); give `size_std` in the entries. Fill in
`source_id`, decide every `review`, then run `apply-plan`.

Exit codes: 0 ok, 1 bad usage/input, 2 the query script failed.
"""

import argparse
import json
import os
import subprocess
import sys
import csv
import io
import tempfile

COLUMNS = [
    "id", "name", "cultivar", "size", "size_std", "unit_price",
    "quantity", "height", "width", "caliper", "is_active",
]


def find_query_script() -> str:
    """Walk up from this file to the agent dir and return its supabase query bin."""
    d = os.path.dirname(os.path.abspath(__file__))
    while True:
        cand = os.path.join(d, "scripts", "agent", "supabase", "query")
        if os.path.isfile(cand):
            return cand
        parent = os.path.dirname(d)
        if parent == d:
            sys.exit("match-candidates: could not locate scripts/agent/supabase/query "
                     "above this script")
        d = parent


def build_sql(supplier_id: int, entries, limit: int, min_sim: float,
              include_inactive: bool) -> str:
    payload = json.dumps(entries)
    if "$json$" in payload:
        sys.exit("match-candidates: entry text contains the literal $json$; rename it")
    active_filter = "" if include_inactive else "AND i.is_active"
    cand_cols = ",\n         ".join(f"s.{c}" for c in COLUMNS)
    sel_cols = ",\n       ".join(f"r.{c}" for c in COLUMNS)
    return f"""
WITH sup AS MATERIALIZED (
  SELECT i.id, i.name, i.name_key,
         i.cultivar_variety_trade_name AS cultivar, i.cultivar_keys,
         i.size, i.size_std, i.unit_price,
         i.quantity, i.height, i.width, i.caliper, i.is_active
  FROM inventory i
  WHERE i.supplier_id = {supplier_id} {active_filter}
),
keys AS MATERIALIZED (SELECT DISTINCT name_key FROM sup),
-- The entry's identity is the composition of whatever parts it gave, so a
-- parts-only entry and a pre-0040 whole-name entry key the same way.
e AS MATERIALIZED (
  SELECT (x.value->>'idx')::int AS idx,
         x.value->>'size'       AS sz,
         normalize_plant_key(
           coalesce(x.value->>'name',
                    compose_plant_name(x.value->>'common_name',
                                       x.value->>'botanical_name',
                                       x.value->>'cultivar'))) AS nk,
         (SELECT coalesce(array_agg(k), '{{}}')
            FROM (SELECT nullif(normalize_plant_key(part), '') AS k
                    FROM regexp_split_to_table(
                           coalesce(x.value->>'cultivar', ''), '\\s*[,;|]\\s*') AS part) z
           WHERE k IS NOT NULL)                                 AS ck
  FROM jsonb_array_elements($json${payload}$json$::jsonb) AS x(value)
),
km AS MATERIALIZED (
  SELECT e.idx, k.name_key, similarity(k.name_key, e.nk) AS sim
  FROM e CROSS JOIN keys k
  WHERE similarity(k.name_key, e.nk) > {min_sim}
),
-- Two selections of one species are two plants, so a named cultivar that
-- disagrees is a hard fact about the candidate, not a scoring nudge. It is
-- reported per candidate and blocks the UPDATE suggestion outright.
cand AS (
  SELECT km.idx,
         {cand_cols},
         (cardinality(e.ck) > 0 AND cardinality(coalesce(s.cultivar_keys, '{{}}')) > 0
            AND NOT (s.cultivar_keys && e.ck))             AS cultivar_mismatch,
         round((0.75 * km.sim
              + 0.25 * (CASE WHEN s.size IS NOT DISTINCT FROM e.sz
                             THEN 1 ELSE 0 END))::numeric, 4) AS score
  FROM km
  JOIN sup s ON s.name_key = km.name_key
  JOIN e     ON e.idx      = km.idx
),
-- Collapse rows that are the same offering spelled the same way. Supplier 32
-- alone carries thousands of retired clones; without this they eat every slot
-- and hide the row you actually want. `dupes` is how many rows collapsed, and
-- `id` is the one to act on — the active one, newest first.
grouped AS (
  SELECT idx, name, cultivar, size, size_std, unit_price, quantity,
         height, width, caliper,
         max(score)                                        AS score,
         bool_or(is_active)                                AS is_active,
         bool_or(cultivar_mismatch)                        AS cultivar_mismatch,
         count(*)                                          AS dupes,
         (array_agg(id ORDER BY is_active DESC, id))[1]    AS id
  FROM cand
  GROUP BY idx, name, cultivar, size, size_std, unit_price, quantity,
           height, width, caliper
),
-- Rank active and inactive separately. Retired history badly outnumbers live
-- rows on established suppliers (supplier 32: 34.9k rows, 5.4k active), so a
-- single ranking lets dead clones take every slot. Active rows get the {limit}
-- slots; inactive gets exactly one, which is all the reactivation case needs.
ranked AS (
  SELECT grouped.*, row_number() OVER (
           PARTITION BY idx, is_active ORDER BY score DESC, dupes DESC, id
         ) AS rn
  FROM grouped
)
SELECT r.idx, r.rn, r.score, r.dupes, r.cultivar_mismatch,
       {sel_cols}
FROM ranked r
WHERE (r.is_active AND r.rn <= {limit}) OR (NOT r.is_active AND r.rn <= 1)
ORDER BY r.idx, r.is_active DESC, r.rn;
""".strip()


def run_query(query_bin: str, sql: str):
    # The query CLI reads stdin synchronously; a pipe can raise EAGAIN before
    # all SQL arrives. Keep its guarded -f path, with an owner-only temp file.
    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8",
                                     prefix="match-candidates-", suffix=".sql") as source:
        source.write(sql)
        source.flush()
        proc = subprocess.run([query_bin, "--csv", "-f", source.name],
                              stdin=subprocess.DEVNULL, capture_output=True, text=True)
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr)
        sys.exit(2)
    return list(csv.DictReader(io.StringIO(proc.stdout)))


def is_true(v) -> bool:
    return str(v).lower() in ("t", "true", "1")


def entry_label(e) -> str:
    """What to print for an entry — the same shape inventory.name is composed in."""
    if e.get("name"):
        return e["name"]
    parts = [e.get("common_name"), e.get("botanical_name"), e.get("cultivar")]
    return " - ".join(p for p in parts if p)


def suggest(cands, hi: float, lo: float):
    """A sort aid, not a decision. §4 of the skill is what actually decides."""
    # A candidate whose cultivar contradicts the entry's is a different plant,
    # so it cannot be what this offering already is. It stays in the printed
    # list — seeing the sibling is useful — but it never drives the suggestion.
    usable = [c for c in cands if not is_true(c["cultivar_mismatch"])]
    live = [c for c in usable if is_true(c["is_active"])]
    dead = [c for c in usable if not is_true(c["is_active"])]

    if not live:
        if dead and float(dead[0]["score"]) >= hi:
            return "reactivate", (f'only match is a retired row at '
                                  f'{float(dead[0]["score"]):.2f}')
        if len(usable) < len(cands):
            return "insert", "every close candidate names a different cultivar"
        return "insert", "no active candidate above the similarity floor"

    top = float(live[0]["score"])
    if top < lo:
        return "insert", f"nearest active row is only {top:.2f}"
    near = [c for c in live if top - float(c["score"]) <= 0.02]
    if len(near) > 1:
        return "review", f"{len(near)} active candidates tie at {top:.2f}"
    if top >= hi:
        return "update", f"single strong active match at {top:.2f}"
    return "review", f"best active match {top:.2f} is in the judgement band"


PLAN_COLUMNS = {
    "common_name": "common_name", "botanical_name": "botanical_name",
    "cultivar": "cultivar_variety_trade_name",
    "cultivar_variety_trade_name": "cultivar_variety_trade_name",
    "size": "size", "size_std": "size_std", "unit_price": "unit_price", "quantity": "quantity",
    "height": "height", "height_std": "height_std", "width": "width", "width_std": "width_std",
    "caliper": "caliper", "caliper_std": "caliper_std", "notes": "notes",
    "internal_notes": "internal_notes", "image_url": "image_url",
}


def search_sql(supplier_id: int, items) -> str:
    """search_inventory for each (idx, term), scoped to one supplier."""
    payload = json.dumps([{"idx": i, "term": term} for i, term in items])
    if "$json$" in payload:
        sys.exit("match-candidates: entry text contains the literal $json$; rename it")
    return f"""
SELECT x.idx, s.id, s.name, s.size, s.size_std, s.unit_price, s.is_active,
       round(s.relevance::numeric, 3) AS relevance
FROM jsonb_to_recordset($json${payload}$json$::jsonb) AS x(idx int, term text)
CROSS JOIN LATERAL (
  SELECT * FROM search_inventory(x.term) r
  WHERE r.supplier_id = {supplier_id}
  ORDER BY r.relevance DESC LIMIT 10) s
ORDER BY x.idx, s.relevance DESC;
""".strip()


def build_plan(supplier_id: int, results, query_bin: str):
    wanted = []
    for res in results:
        if res["suggest"] == "insert":
            e = res["entry"]
            cultivar = e.get("cultivar") or ""
            for base in {e.get("common_name"), e.get("botanical_name"), e.get("name")} - {None, ""}:
                wanted.append((res["idx"], f"{base} {cultivar}".strip()))
    hits = {}
    for start in range(0, len(wanted), 100):
        for r in run_query(query_bin, search_sql(supplier_id, wanted[start:start + 100])):
            hits.setdefault(int(r["idx"]), {})[r["id"]] = r
    rows = []
    for res in results:
        e = res["entry"]
        values = {PLAN_COLUMNS[k]: v for k, v in e.items() if k in PLAN_COLUMNS}
        if res["suggest"] in ("update", "reactivate"):
            # A match keeps its stored name; only offering values refresh.
            values = {k: v for k, v in values.items()
                      if k not in ("common_name", "botanical_name", "cultivar_variety_trade_name")}
        row = {"idx": res["idx"], "action": res["suggest"], "why": res["why"],
               "label": entry_label(e), "set": values}
        usable = [c for c in res["candidates"] if not is_true(c["cultivar_mismatch"])]
        if res["suggest"] in ("update", "reactivate") and usable:
            live = [c for c in usable if is_true(c["is_active"]) == (res["suggest"] == "update")]
            row["id"] = (live or usable)[0]["id"]
        elif res["suggest"] == "insert":
            found = list(hits.get(res["idx"], {}).values())
            same = [h for h in found if (h["size"] or "") == (e.get("size") or "")
                    or (e.get("size_std") and h["size_std"] == e.get("size_std"))]
            if same:
                row["action"] = "review"
                row["why"] = "search_inventory found this plant in the same size: " + \
                    ", ".join(f'{h["id"]} {h["name"]} {h["size"]} ${h["unit_price"]}'
                              + ("" if is_true(h["is_active"]) else " INACTIVE") for h in same)
            else:
                row["searched"] = True
        if row["action"] == "review":
            row["candidates"] = [{k: c[k] for k in ("id", "name", "size", "unit_price", "is_active", "score")}
                                 for c in res["candidates"]]
        rows.append(row)
    return {"supplier_id": supplier_id, "source_id": None, "rows": rows}


def main() -> None:
    p = argparse.ArgumentParser(add_help=True, description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--supplier", type=int, required=True)
    p.add_argument("--entries")
    p.add_argument("--limit", type=int, default=5)
    p.add_argument("--min-sim", type=float, default=0.25)
    p.add_argument("--batch", type=int, default=200)
    p.add_argument("--format", choices=["text", "json"], default="text")
    p.add_argument("--high", type=float, default=0.95, help="suggest update at/above")
    p.add_argument("--low", type=float, default=0.55, help="suggest insert below")
    p.add_argument("--plan", help="write a decision plan for apply-plan to this file")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--include-inactive", dest="inactive", action="store_true", default=True)
    g.add_argument("--active-only", dest="inactive", action="store_false")
    a = p.parse_args()

    raw = open(a.entries).read() if a.entries else sys.stdin.read()
    try:
        entries = json.loads(raw)
    except json.JSONDecodeError as exc:
        sys.exit(f"match-candidates: entries are not valid JSON — {exc}")
    if not isinstance(entries, list) or not entries:
        sys.exit("match-candidates: entries must be a non-empty JSON array")
    for i, e in enumerate(entries):
        if not isinstance(e, dict) or not (
            e.get("name") or e.get("common_name") or e.get("botanical_name")
            or e.get("cultivar")
        ):
            sys.exit(f"match-candidates: entry {i} has no name — give it "
                     "common_name / botanical_name / cultivar, or a whole 'name'")
        e["idx"] = i

    query_bin = os.environ.get("DAISY_QUERY_BIN") or find_query_script()
    rows = []
    for start in range(0, len(entries), a.batch):
        chunk = entries[start:start + a.batch]
        rows += run_query(query_bin, build_sql(a.supplier, chunk, a.limit,
                                               a.min_sim, a.inactive))

    by_idx = {}
    for r in rows:
        by_idx.setdefault(int(r["idx"]), []).append(r)

    results = []
    for i, e in enumerate(entries):
        cands = by_idx.get(i, [])
        action, why = suggest(cands, a.high, a.low)
        results.append({"idx": i, "entry": e, "suggest": action,
                        "why": why, "candidates": cands})

    if a.plan:
        plan = build_plan(a.supplier, results, query_bin)
        with open(a.plan, "w", encoding="utf-8") as handle:
            json.dump(plan, handle, indent=1, default=str)
        tally = {}
        for row in plan["rows"]:
            tally[row["action"]] = tally.get(row["action"], 0) + 1
        sys.stderr.write(f'plan written to {a.plan}: ' +
                         ", ".join(f"{v} {k}" for k, v in sorted(tally.items())) + "\n")

    if a.format == "json":
        json.dump(results, sys.stdout, indent=2, default=str)
        sys.stdout.write("\n")
        return

    counts = {}
    for res in results:
        counts[res["suggest"]] = counts.get(res["suggest"], 0) + 1
        e = res["entry"]
        print(f'[{res["idx"]}] {entry_label(e)}  size={e.get("size")}  '
              f'price={e.get("unit_price")}  qty={e.get("quantity")}')
        print(f'      SUGGEST {res["suggest"].upper()} — {res["why"]}')
        for c in res["candidates"]:
            flag = "" if is_true(c["is_active"]) else "  INACTIVE"
            if is_true(c["cultivar_mismatch"]):
                flag += "  CULTIVAR MISMATCH"
            dupes = f'  x{c["dupes"]}' if int(c["dupes"]) > 1 else ""
            print(f'      {c["score"]}  {c["id"]}  {c["name"]}  | {c["size"]} '
                  f'({c["size_std"]})  ${c["unit_price"]}  qty={c["quantity"]}  '
                  f'h={c["height"]} w={c["width"]} cal={c["caliper"]}{flag}{dupes}')
        if not res["candidates"]:
            print("      (no candidate above the similarity floor)")
        print()
    print(f'{len(results)} entries — ' +
          ", ".join(f"{v} {k}" for k, v in sorted(counts.items())))


if __name__ == "__main__":
    main()
