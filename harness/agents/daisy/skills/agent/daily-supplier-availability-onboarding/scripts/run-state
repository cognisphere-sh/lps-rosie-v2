#!/usr/bin/env python3
"""Durable evidence journals for Daisy's daily supplier onboarding coordinator."""

import argparse
import fcntl
import hashlib
import json
import os
import re
import shutil
import stat
import tempfile
from contextlib import ExitStack
from datetime import date, datetime, timezone
from pathlib import Path

SLUG_RE = re.compile(r"^[a-z0-9](?:[a-z0-9-]{0,62})$")
RUN_RE = re.compile(r"^20[0-9]{2}-[01][0-9]-[0-3][0-9]$")
DECIMAL_RE = re.compile(r"^[1-9][0-9]*$")
RESULT_STATUSES = {"in-progress", "final"}
JOURNAL_SCHEMA = 1


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False)


def sha(value):
    return hashlib.sha256(canonical(value).encode()).hexdigest()


def file_sha(path):
    path = Path(path).absolute(); no_symlinks(path); h = hashlib.sha256(); fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode): raise ValueError(f"hash input must be regular: {path}")
        with os.fdopen(fd, "rb") as handle:
            fd = -1
            while chunk := handle.read(1024 * 1024): h.update(chunk)
    finally:
        if fd >= 0: os.close(fd)
    return h.hexdigest()


def timestamp():
    return datetime.now(timezone.utc).isoformat()


def parse_timestamp(value, label):
    if not isinstance(value, str):
        raise ValueError(f"{label} must be an ISO timestamp")
    try:
        datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as error:
        raise ValueError(f"{label} must be an ISO timestamp") from error


def no_symlinks(path, leaf_may_be_missing=False):
    path = Path(path).absolute()
    parts = path.parts
    current = Path(parts[0])
    for index, part in enumerate(parts[1:], 1):
        current /= part
        try:
            mode = os.lstat(current).st_mode
        except FileNotFoundError:
            if leaf_may_be_missing and index == len(parts) - 1:
                return
            raise ValueError(f"missing path component: {current}")
        if stat.S_ISLNK(mode):
            raise ValueError(f"symlink path component rejected: {current}")
        if index < len(parts) - 1 and not stat.S_ISDIR(mode):
            raise ValueError(f"non-directory path component: {current}")


def regular_file(path, label):
    no_symlinks(path)
    if not stat.S_ISREG(os.lstat(path).st_mode):
        raise ValueError(f"{label} must be a regular file")


def safe_directory(path, create=False):
    path = Path(path).absolute()
    if create:
        parent = path.parent
        no_symlinks(parent)
        path.mkdir(mode=0o700, exist_ok=True)
    no_symlinks(path)
    if not stat.S_ISDIR(os.lstat(path).st_mode):
        raise ValueError(f"not a directory: {path}")
    os.chmod(path, 0o700)
    return path


def load(path):
    path = Path(path).absolute(); no_symlinks(path)
    fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode): raise ValueError(f"JSON input must be regular: {path}")
        with os.fdopen(fd, "r", encoding="utf-8") as handle:
            fd = -1; return json.load(handle)
    finally:
        if fd >= 0: os.close(fd)


def write_all(fd, data):
    limit = int(os.environ.get("RUN_STATE_MAX_WRITE", "0")) or len(data)
    view = memoryview(data)
    while view:
        count = os.write(fd, view[:limit])
        if count <= 0:
            raise OSError("short write")
        view = view[count:]


def fsync_directory(path):
    fd = os.open(path, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def atomic_bytes(path, data, mode=0o600):
    path = Path(path).absolute()
    safe_directory(path.parent)
    no_symlinks(path, leaf_may_be_missing=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, mode)
        write_all(fd, data)
        os.fsync(fd)
        os.close(fd)
        fd = -1
        os.replace(temporary, path)
        fsync_directory(path.parent)
    except BaseException:
        if fd >= 0:
            os.close(fd)
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def atomic_json(path, value):
    atomic_bytes(path, (json.dumps(value, indent=2, ensure_ascii=False) + "\n").encode())


def deleted_lock_inode_exists(path):
    target = str(Path(path).absolute()) + " (deleted)"
    proc = Path("/proc")
    if not proc.exists(): return False
    for process in proc.iterdir():
        if not process.name.isdigit(): continue
        descriptors = process / "fd"
        try:
            for descriptor in descriptors.iterdir():
                try:
                    if os.readlink(descriptor) == target: return True
                except (FileNotFoundError, PermissionError, OSError): pass
        except (FileNotFoundError, PermissionError): pass
    return False


def locked(path):
    path = Path(path).absolute(); parent = safe_directory(path.parent)
    no_symlinks(path, leaf_may_be_missing=True)
    try:
        before = os.lstat(path); existed = True
    except FileNotFoundError:
        before = None; existed = False
    if deleted_lock_inode_exists(path): raise ValueError(f"replaced lock inode is still open: {path}")
    flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0); fd = os.open(path, flags, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        opened = os.fstat(fd); current = os.lstat(path)
        opened_identity = (opened.st_dev, opened.st_ino); current_identity = (current.st_dev, current.st_ino)
        if opened_identity != current_identity: raise ValueError(f"lock inode replaced during acquisition: {path}")
        if before is not None and opened_identity != (before.st_dev, before.st_ino): raise ValueError(f"lock pathname identity changed during acquisition: {path}")
        if deleted_lock_inode_exists(path): raise ValueError(f"replaced lock inode is still open after acquisition: {path}")
        if not stat.S_ISREG(opened.st_mode) or opened.st_uid != os.geteuid(): raise ValueError(f"invalid lock ownership/type: {path}")
        if stat.S_IMODE(opened.st_mode) != 0o600: raise ValueError(f"lock mode must be 0600: {path}")
        if not existed: fsync_directory(parent)
        return os.fdopen(fd, "a+", encoding="utf-8")
    except BaseException:
        os.close(fd); raise


def validate_run_path(run_file):
    run_file = Path(run_file).absolute()
    regular_file(run_file, "run file")
    if run_file.suffix != ".json" or not RUN_RE.fullmatch(run_file.stem):
        raise ValueError("run file must be named YYYY-MM-DD.json")
    date.fromisoformat(run_file.stem)
    return run_file


def safe_slug(value):
    if not isinstance(value, str) or not SLUG_RE.fullmatch(value):
        raise ValueError(f"unsafe batch id: {value!r}")
    return value


def validate_result(result):
    if not isinstance(result, dict) or result.get("status") not in RESULT_STATUSES:
        raise ValueError("result must be an object with status in-progress or final")
    if result["status"] == "final":
        outcome = result.get("outcome", result.get("final_outcome", result.get("gate")))
        if not isinstance(outcome, str) or not outcome.strip():
            raise ValueError("final result requires outcome, final_outcome, or gate")


def validate_plan(selected, batches):
    if not isinstance(selected, list) or not selected or any(type(item) is not int or item < 1 for item in selected):
        raise ValueError("selected_supplier_ids must be positive integers")
    if len(selected) != len(set(selected)):
        raise ValueError("selected_supplier_ids must be unique")
    if not isinstance(batches, dict) or not batches:
        raise ValueError("batch plan must be a non-empty object")
    planned = []
    for batch, supplier_ids in batches.items():
        safe_slug(batch)
        if not isinstance(supplier_ids, list) or not supplier_ids or any(type(item) is not int for item in supplier_ids):
            raise ValueError(f"invalid supplier ids for {batch}")
        planned.extend(supplier_ids)
    if len(planned) != len(set(planned)):
        raise ValueError("supplier appears in multiple batches")
    if set(planned) != set(selected):
        raise ValueError("batch plan must cover the selected cohort exactly")
    return sha({"selected_supplier_ids": selected, "batches": batches})


def validate_run(run, require_plan=True, expected_run_id=None):
    if not isinstance(run, dict) or run.get("status") not in {"running", "completed"}:
        raise ValueError("invalid run object/status")
    run_id = run.get("run_id")
    if not isinstance(run_id, str) or not RUN_RE.fullmatch(run_id): raise ValueError("run payload requires run_id YYYY-MM-DD")
    date.fromisoformat(run_id)
    if expected_run_id is not None and run_id != expected_run_id: raise ValueError("run payload run_id does not match physical run file")
    parse_timestamp(run.get("started_at"), "started_at")
    if require_plan:
        plan_id = validate_plan(run.get("selected_supplier_ids"), run.get("batches"))
        if run.get("plan_frozen") is not True or run.get("plan_id") != plan_id:
            raise ValueError("batch plan is not frozen or has changed")


def validate_state(state):
    if not isinstance(state, dict) or type(state.get("schema_version")) is not int or state["schema_version"] < 1:
        raise ValueError("state requires positive integer schema_version")
    if not isinstance(state.get("runs"), dict):
        raise ValueError("state.runs must be an object")
    reviewed = state.get("reviewed_supplier_ids")
    if not isinstance(reviewed, list) or any(type(item) is not int or item < 1 for item in reviewed) or len(reviewed) != len(set(reviewed)):
        raise ValueError("state.reviewed_supplier_ids must be unique positive integers")
    latest = state.get("last_completed_run")
    if latest is not None:
        if not isinstance(latest, str) or not RUN_RE.fullmatch(latest):
            raise ValueError("state.last_completed_run must be null or YYYY-MM-DD")
        date.fromisoformat(latest)
        if type(state.get("last_supplier_id")) is not int or state["last_supplier_id"] < 1:
            raise ValueError("completed state requires positive last_supplier_id")
    for run_id, run in state["runs"].items():
        if not RUN_RE.fullmatch(run_id):
            raise ValueError(f"invalid state run id: {run_id}")
        date.fromisoformat(run_id)
        if not isinstance(run, dict) or run.get("status") not in {"running", "completed"} or run.get("run_id") != run_id:
            raise ValueError(f"state key/payload run_id mismatch: {run_id}")
    authorizations = state.get("recovery_import_authorizations", {})
    if not isinstance(authorizations, dict): raise ValueError("state recovery_import_authorizations must be an object")
    for run_id, authorization in authorizations.items():
        if not RUN_RE.fullmatch(run_id) or not isinstance(authorization, dict) or authorization.get("run_id") != run_id or not authorization.get("manifest_path") or not authorization.get("manifest_hash") or not authorization.get("evidence_path") or not authorization.get("evidence_hash") or not authorization.get("selected_supplier_ids_hash"):
            raise ValueError(f"invalid recovery import authorization: {run_id}")
    if latest is not None:
        latest_run = state["runs"].get(latest)
        selected = latest_run.get("selected_supplier_ids") if isinstance(latest_run, dict) else None
        if not isinstance(latest_run, dict) or latest_run.get("status") != "completed" or not isinstance(selected, list) or not selected or state["last_supplier_id"] != selected[-1]:
            raise ValueError("state latest run/cursor consistency mismatch")
    return state


def migrate_state_run_ids(args):
    state_file = Path(args.state_file).absolute(); raw = load(state_file)
    if not isinstance(raw, dict) or not isinstance(raw.get("runs"), dict) or not isinstance(raw.get("reviewed_supplier_ids"), list):
        raise ValueError("legacy state shape is invalid")
    runs_dir = Path(args.runs_dir).absolute() if args.runs_dir else state_file.parent / "runs"
    safe_directory(runs_dir, create=True)
    with locked(state_file.parent / ".daily-onboarding-state.lock"):
        state = load(state_file)
        for directory_name in ("run-state-transactions", "run-state-import-transactions"):
            directory = state_file.parent / directory_name
            if directory.exists() and any(directory.glob("*.json")):
                raise ValueError("run-id migration requires no transaction journals")
        changed_state = False; changed_files = []
        for run_path in sorted(runs_dir.glob("*.json")):
            run_path = validate_run_path(run_path)
            with locked(f"{run_path}.lock"):
                payload = load(run_path)
                if not isinstance(payload, dict) or payload.get("status") not in {"running", "completed"}:
                    raise ValueError(f"invalid standalone legacy run: {run_path.name}")
                if payload.get("run_id") is None:
                    payload["run_id"] = run_path.stem
                elif payload["run_id"] != run_path.stem:
                    raise ValueError(f"standalone legacy run_id mismatch: {run_path.name}")
                if payload["status"] == "completed" and not payload.get("plan_frozen"):
                    payload["legacy_completed"] = True
                original = load(run_path)
                if payload != original:
                    atomic_json(run_path, payload); changed_files.append(run_path.name)
        for run_id, payload in state["runs"].items():
            if not RUN_RE.fullmatch(run_id) or not isinstance(payload, dict) or payload.get("status") not in {"running", "completed"}:
                raise ValueError(f"invalid legacy state run: {run_id}")
            if payload.get("run_id") is None:
                payload["run_id"] = run_id; changed_state = True
            elif payload["run_id"] != run_id:
                raise ValueError(f"legacy state run_id mismatch: {run_id}")
            if payload["status"] == "completed" and not payload.get("plan_frozen") and not payload.get("legacy_completed"):
                payload["legacy_completed"] = True; changed_state = True
        state["schema_version"] = max(3, state.get("schema_version", 0)); validate_state(state)
        if changed_state or state != raw: atomic_json(state_file, state)
    print(json.dumps({"ok": True, "changed": bool(changed_state or changed_files or state != raw), "changed_run_files": changed_files, "schema_version": state["schema_version"]}))


def batch_root(run_file, create=False):
    root = Path(run_file).parent / "batch-results" / Path(run_file).stem
    if create:
        safe_directory(root.parent, create=True)
        return safe_directory(root, create=True)
    if root.exists() or root.is_symlink():
        return safe_directory(root)
    return root.absolute()


def batch_file(run_file, batch):
    safe_slug(batch)
    root = batch_root(run_file)
    path = root / f"{batch}.jsonl"
    no_symlinks(path, leaf_may_be_missing=True)
    return path


def expected_batch_files(run_file, run):
    root = batch_root(run_file)
    if not root.exists():
        return
    expected = {f"{batch}.jsonl" for batch in run["batches"]} | {f"{batch}.jsonl.lock" for batch in run["batches"]}
    unexpected = sorted(item.name for item in root.iterdir() if item.name not in expected)
    if unexpected:
        raise ValueError(f"unexpected/orphan batch entries: {unexpected}")


def read_batch(run_file, run, batch):
    path = batch_file(run_file, batch)
    latest = {}
    count = 0
    if not path.exists():
        return latest, count
    regular_file(path, "batch log")
    fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    if not stat.S_ISREG(os.fstat(fd).st_mode): os.close(fd); raise ValueError("batch log must be regular")
    with os.fdopen(fd, "r", encoding="utf-8") as handle:
        for line_number, line in enumerate(handle, 1):
            if not line.endswith("\n"):
                raise ValueError(f"torn event at {path}:{line_number}")
            event = json.loads(line)
            supplier_id = event.get("supplier_id")
            if event.get("run_id") != run_file.stem or event.get("plan_id") != run["plan_id"] or event.get("batch_id") != batch or supplier_id not in run["batches"][batch]:
                raise ValueError(f"event outside frozen plan at {path}:{line_number}")
            parse_timestamp(event.get("recorded_at"), "recorded_at")
            validate_result(event.get("result"))
            previous = latest.get(supplier_id)
            expected_sequence = previous["sequence"] + 1 if previous else 1
            if event.get("sequence") != expected_sequence:
                raise ValueError(f"bad sequence for supplier {supplier_id}")
            body = {key: value for key, value in event.items() if key != "event_id"}
            if event.get("event_id") != sha(body):
                raise ValueError(f"event hash mismatch at {path}:{line_number}")
            correction = event.get("correction")
            if previous:
                if not isinstance(correction, dict) or correction.get("previous_event_id") != previous["event_id"] or not correction.get("reason") or not correction.get("evidence_reference"):
                    raise ValueError(f"invalid correction audit for supplier {supplier_id}")
            elif correction is not None:
                raise ValueError("first event cannot be a correction")
            latest[supplier_id] = event
            count += 1
    return latest, count


def merged_run(run_file, run):
    expected_batch_files(run_file, run)
    results = {}
    provenance = {}
    event_counts = {}
    for batch in run["batches"]:
        latest, event_counts[batch] = read_batch(run_file, run, batch)
        for supplier_id, event in latest.items():
            results[str(supplier_id)] = event["result"]
            provenance[str(supplier_id)] = {"batch_id": batch, "event_id": event["event_id"], "sequence": event["sequence"], "recorded_at": event["recorded_at"]}
    output = dict(run)
    output["supplier_results"] = {str(item): results[str(item)] for item in run["selected_supplier_ids"] if str(item) in results}
    output["result_provenance"] = {str(item): provenance[str(item)] for item in run["selected_supplier_ids"] if str(item) in provenance}
    output["merge_summary"] = {"result_count": len(results), "missing_supplier_ids": [item for item in run["selected_supplier_ids"] if str(item) not in results], "event_counts": event_counts}
    return output


def validate_evidence(path, run):
    evidence = load(path)
    parse_timestamp(evidence.get("verified_at"), "evidence.verified_at")
    for key, expected in {"selected_count": len(run["selected_supplier_ids"]), "result_count": len(run["selected_supplier_ids"]), "sent_email_count": 0, "contact_count": 0}.items():
        if evidence.get(key) != expected:
            raise ValueError(f"evidence {key} must equal {expected}")
    assertions = evidence.get("read_only_assertions")
    if not isinstance(assertions, dict) or assertions.get("no_external_actions_performed") is not True or type(assertions.get("database_checked")) is not bool or type(assertions.get("gmail_checked")) is not bool:
        raise ValueError("evidence requires explicit read-only database/Gmail/action assertions")
    artifacts = evidence.get("reconciliation_artifacts")
    if not isinstance(artifacts, list) or not artifacts:
        raise ValueError("evidence requires hashed reconciliation artifacts")
    for artifact in artifacts:
        artifact_path = Path(artifact.get("path", ""))
        regular_file(artifact_path, "reconciliation artifact")
        if artifact.get("sha256") != file_sha(artifact_path):
            raise ValueError("reconciliation artifact hash mismatch")
    sources = evidence.get("sources", [])
    drafts = evidence.get("drafts", [])
    signups = evidence.get("signup_failures", [])
    for source in sources:
        if not source.get("id") or source.get("is_active") is not True or type(source.get("active_rows")) is not int:
            raise ValueError("invalid source verification")
    for draft in drafts:
        if not draft.get("id") or draft.get("status") != "draft":
            raise ValueError("draft verification must confirm draft status")
    for signup in signups:
        if signup.get("terminal") is not True:
            raise ValueError("signup failure must be terminal")
    outcomes = {}
    for result in run["supplier_results"].values():
        outcome = result.get("outcome", result.get("final_outcome", result.get("gate")))
        outcomes[outcome] = outcomes.get(outcome, 0) + 1
    computed = {"source_count": len(sources), "source_active_rows_total": sum(source["active_rows"] for source in sources), "draft_count": len(drafts), "signup_failure_count": len(signups), "outcome_counts": outcomes}
    for key, value in computed.items():
        if evidence.get(key) != value:
            raise ValueError(f"evidence {key} does not match evidence arrays/results")
    if not evidence.get("method") or not evidence.get("verified_by"):
        raise ValueError("evidence requires method and verified_by")
    return evidence


def journal_with_hash(core, phase):
    journal = {**core, "phase": phase}
    journal["journal_hash"] = sha(journal)
    return journal


def validate_journal(journal, phases, kind):
    if not isinstance(journal, dict) or journal.get("schema_version") != JOURNAL_SCHEMA or journal.get("kind") != kind or journal.get("phase") not in phases:
        raise ValueError(f"invalid {kind} journal schema/phase")
    supplied = journal.get("journal_hash")
    body = {key: value for key, value in journal.items() if key != "journal_hash"}
    if supplied != sha(body):
        raise ValueError(f"tampered {kind} journal")
    return journal


def transaction_dirs(state_file):
    state_root = safe_directory(Path(state_file).parent)
    return (safe_directory(state_root / "run-state-transactions", create=True), safe_directory(state_root / "run-state-import-transactions", create=True))


def validate_delta(journal):
    delta = journal.get("delta")
    if not isinstance(delta, dict) or delta.get("run_id") != journal["transaction_core"].get("run_id"):
        raise ValueError("completion delta run id mismatch")
    completed_run = delta.get("completed_run")
    if not isinstance(completed_run, dict) or completed_run.get("status") != "completed":
        raise ValueError("completion delta lacks completed run")
    core_run_id = journal["transaction_core"].get("run_id")
    validate_run(completed_run, expected_run_id=core_run_id)
    if completed_run.get("run_id") != delta.get("run_id"):
        raise ValueError("completed run/delta run_id mismatch")
    selected = completed_run["selected_supplier_ids"]
    if delta.get("reviewed_supplier_ids") != selected or len(selected) != len(set(selected)) or delta.get("last_supplier_id") != selected[-1]:
        raise ValueError("completion delta reviewed/cursor semantics mismatch")
    expected_keys = [str(item) for item in selected]
    if list(completed_run.get("supplier_results", {})) != expected_keys or list(completed_run.get("result_provenance", {})) != expected_keys:
        raise ValueError("completed run result/provenance ordering mismatch")
    if sha(completed_run["result_provenance"]) != journal["transaction_core"].get("result_hash") or sha(completed_run["supplier_results"]) != journal["transaction_core"].get("supplier_results_hash"):
        raise ValueError("completion delta result binding mismatch")
    if sha(completed_run) != delta.get("completed_run_hash") or completed_run.get("completion_transaction_id") != journal["transaction_id"]:
        raise ValueError("completion journal payload hash mismatch")
    return delta, completed_run


def apply_completion_delta(state, journal):
    validate_state(state)
    delta, completed_run = validate_delta(journal)
    existing = state.setdefault("runs", {}).get(delta["run_id"])
    if existing:
        if existing.get("completion_transaction_id") != journal["transaction_id"] or sha(existing) != delta["completed_run_hash"]:
            raise ValueError("state contains conflicting completed run")
    else:
        state["runs"][delta["run_id"]] = completed_run
    reviewed = state.setdefault("reviewed_supplier_ids", [])
    reviewed.extend(item for item in delta["reviewed_supplier_ids"] if item not in reviewed)
    current = state.get("last_completed_run")
    if current is None or delta["run_id"] > current:
        state["last_completed_run"] = delta["run_id"]
        state["last_supplier_id"] = delta["last_supplier_id"]
    validate_state(state)
    return state


def validate_completion_location(journal_path, state_file, journal):
    run_file = validate_run_path(journal["run_file"])
    expected_name = f"{run_file.stem}-{journal.get('transaction_id')}.json"
    expected_parent = transaction_dirs(state_file)[0]
    if Path(journal_path).absolute().parent != expected_parent or Path(journal_path).name != expected_name:
        raise ValueError("completion journal path/name binding mismatch")
    if journal.get("state_file") != str(Path(state_file).absolute()) or journal.get("transaction_core", {}).get("run_id") != run_file.stem or journal.get("delta", {}).get("run_id") != run_file.stem:
        raise ValueError("completion journal run_id/path binding mismatch")
    return run_file


def advance_completion(journal_path, state_file, allow_injection=True):
    journal = validate_journal(load(journal_path), {"prepared", "run-written", "committed"}, "completion")
    run_file = validate_completion_location(journal_path, state_file, journal)
    core_binding = journal["transaction_core"]
    if core_binding.get("run_file") != journal["run_file"] or core_binding.get("state_file") != journal["state_file"]:
        raise ValueError("completion transaction path binding mismatch")
    identity_keys = ("run_id", "run_file", "state_file", "plan_id", "result_hash", "supplier_results_hash", "evidence_hash", "canonical_running_run_hash")
    identity = {key: core_binding[key] for key in identity_keys}
    if journal["transaction_id"] != sha(identity):
        raise ValueError("completion transaction id mismatch")
    delta, completed_run = validate_delta(journal)
    if core_binding["completed_run_hash"] != delta["completed_run_hash"]:
        raise ValueError("completion transaction/payload mismatch")
    if journal["phase"] == "committed":
        return journal
    with locked(f"{run_file}.lock"):
        current = load(run_file)
        validate_run(current, expected_run_id=run_file.stem)
        if current["plan_id"] != core_binding["plan_id"]:
            raise ValueError("completion recovery plan changed")
        with ExitStack() as stack:
            for batch in sorted(current["batches"]):
                stack.enter_context(locked(f"{batch_file(run_file, batch)}.lock"))
            canonical_run = merged_run(run_file, current)
            if sha(canonical_run["result_provenance"]) != core_binding["result_hash"] or sha(canonical_run["supplier_results"]) != core_binding["supplier_results_hash"]:
                raise ValueError("completion recovery evidence changed after prepare")
            if journal["phase"] == "prepared":
                running_view = dict(canonical_run)
                running_view.pop("completed_at", None); running_view.pop("completion_transaction_id", None); running_view.pop("evidence_verification", None)
                running_view["status"] = "running"
                if sha(running_view) != core_binding["canonical_running_run_hash"]:
                    raise ValueError("canonical running run changed after prepare")
                atomic_json(run_file, completed_run)
                stored = {key: value for key, value in journal.items() if key not in {"phase", "journal_hash"}}
                journal = journal_with_hash(stored, "run-written")
                atomic_json(journal_path, journal)
                if allow_injection and os.environ.get("RUN_STATE_FAIL_AFTER_RUN_WRITE") == "1":
                    raise OSError("injected failure after run write")
            if journal["phase"] == "run-written":
                if sha(load(run_file)) != delta["completed_run_hash"]:
                    raise ValueError("completed run changed before state commit")
                state = apply_completion_delta(load(state_file), journal)
                atomic_json(state_file, state)
                stored = {key: value for key, value in journal.items() if key not in {"phase", "journal_hash"}}
                journal = journal_with_hash(stored, "committed")
                atomic_json(journal_path, journal)
    return journal


def recover_pending_completions(state_file):
    completion_dir, _ = transaction_dirs(state_file)
    pending = []
    for path in sorted(completion_dir.glob("*.json")):
        journal = validate_journal(load(path), {"prepared", "run-written", "committed"}, "completion")
        validate_completion_location(path, state_file, journal)
        validate_delta(journal)
        if journal["phase"] != "committed":
            pending.append(path)
    for path in pending:
        advance_completion(path, state_file, allow_injection=False)
    return [path.name for path in pending]


def freeze_plan(args):
    run_file = validate_run_path(args.run_file)
    state_file = Path(args.state_file).absolute(); validate_state(load(state_file))
    plan = load(args.batch_plan)
    with locked(state_file.parent / ".daily-onboarding-state.lock"):
        recover_pending_completions(state_file); recover_pending_imports(state_file)
        with locked(f"{run_file}.lock"):
            run = load(run_file)
            if run.get("run_id") is None: run["run_id"] = run_file.stem
            if run.get("run_id") != run_file.stem: raise ValueError("run payload run_id does not match physical run file")
            if run.get("status") != "running":
                raise ValueError("completed run is immutable")
            root = batch_root(run_file)
            if root.exists() and any(root.iterdir()):
                raise ValueError("cannot freeze/change plan after evidence exists")
            plan_id = validate_plan(run.get("selected_supplier_ids"), plan)
            if run.get("plan_frozen"):
                if run.get("plan_id") != plan_id or run.get("batches") != plan:
                    raise ValueError("frozen plan is immutable")
                print(json.dumps({"ok": True, "plan_id": plan_id, "unchanged": True}))
                return
            run.update(batches=plan, plan_frozen=True, plan_id=plan_id)
            atomic_json(run_file, run)
    print(json.dumps({"ok": True, "plan_id": plan_id}))


def append_result(args):
    run_file = validate_run_path(args.run_file)
    state_file = Path(args.state_file).absolute(); validate_state(load(state_file))
    result = load(args.result_file); validate_result(result)
    recorded_at = args.recorded_at or timestamp(); parse_timestamp(recorded_at, "recorded_at")
    batch = safe_slug(args.batch_id)
    with locked(state_file.parent / ".daily-onboarding-state.lock"):
        recover_pending_completions(state_file); recover_pending_imports(state_file)
        with locked(f"{run_file}.lock"):
            run = load(run_file); validate_run(run, expected_run_id=run_file.stem)
            if run["status"] == "completed": raise ValueError("completed run is immutable")
            if batch not in run["batches"] or args.supplier_id not in run["batches"][batch]: raise ValueError("supplier is not assigned to batch")
            batch_root(run_file, create=True); path = batch_file(run_file, batch)
            with locked(f"{path}.lock"):
                latest, _ = read_batch(run_file, run, batch); previous = latest.get(args.supplier_id); correction = None
                if previous:
                    if not args.correct or not args.reason or not args.evidence_reference: raise ValueError("correction requires --correct, --reason and --evidence-reference")
                    correction = {"previous_event_id": previous["event_id"], "reason": args.reason, "evidence_reference": args.evidence_reference}
                elif args.correct: raise ValueError("cannot correct a missing event")
                event = {"run_id": run_file.stem, "plan_id": run["plan_id"], "batch_id": batch, "supplier_id": args.supplier_id, "sequence": previous["sequence"] + 1 if previous else 1, "recorded_at": recorded_at, "result": result}
                if correction: event["correction"] = correction
                event["event_id"] = sha(event); created = not path.exists(); flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0); fd = os.open(path, flags, 0o600)
                try: os.fchmod(fd, 0o600); write_all(fd, (canonical(event) + "\n").encode()); os.fsync(fd)
                finally: os.close(fd)
                if created: fsync_directory(path.parent)
    print(json.dumps({"ok": True, "event_id": event["event_id"], "sequence": event["sequence"]}))


def merge(args):
    run_file = validate_run_path(args.run_file)
    if not args.state_file:
        raise ValueError("merge requires --state-file")
    state_file = Path(args.state_file).absolute()
    validate_state(load(state_file))
    if args.complete and not args.evidence_manifest:
        raise ValueError("--complete requires --evidence-manifest")
    with locked(state_file.parent / ".daily-onboarding-state.lock"):
        recovered = recover_pending_completions(state_file)
        recovered += recover_pending_imports(state_file)
        with locked(f"{run_file}.lock"):
            run = load(run_file)
            if run.get("status") == "completed":
                if not args.complete:
                    raise ValueError("completed run is immutable")
                assert_completed_consistent(run_file, state_file, run)
                print(json.dumps({"ok": True, "status": "completed", "completion_transaction_id": run["completion_transaction_id"], "recovered_pending": recovered, "unchanged": True}))
                return
            validate_run(run, expected_run_id=run_file.stem)
            state = validate_state(load(state_file))
            if args.complete:
                last_completed = state.get("last_completed_run")
                if last_completed is not None and run_file.stem <= last_completed:
                    raise ValueError(f"out-of-order normal completion rejected: {run_file.stem} <= {last_completed}")
            with ExitStack() as stack:
                for batch in sorted(run["batches"]):
                    stack.enter_context(locked(f"{batch_file(run_file, batch)}.lock"))
                output = merged_run(run_file, run)
                if not args.complete:
                    atomic_json(run_file, output)
                    print(json.dumps({"ok": True, "status": output["status"], "result_count": len(output["supplier_results"]), "recovered_pending": recovered}))
                    return
                missing = output["merge_summary"]["missing_supplier_ids"]
                nonfinal = [key for key, value in output["supplier_results"].items() if value.get("status") != "final"]
                if missing or nonfinal:
                    raise ValueError(f"cannot complete: missing={missing}, nonfinal={nonfinal}")
                evidence = validate_evidence(args.evidence_manifest, output)
                completed_at = args.completed_at or timestamp(); parse_timestamp(completed_at, "completed_at")
                result_hash = sha(output["result_provenance"])
                supplier_results_hash = sha(output["supplier_results"])
                canonical_running_run_hash = sha(output)
                preliminary = {"run_id": run_file.stem, "run_file": str(run_file), "state_file": str(state_file), "plan_id": output["plan_id"], "result_hash": result_hash, "supplier_results_hash": supplier_results_hash, "evidence_hash": sha(evidence), "canonical_running_run_hash": canonical_running_run_hash}
                transaction_id = sha(preliminary)
                completed_run = dict(output)
                completed_run.update(status="completed", completed_at=completed_at, completion_transaction_id=transaction_id, evidence_verification=evidence)
                delta = {"run_id": run_file.stem, "completed_run": completed_run, "completed_run_hash": sha(completed_run), "reviewed_supplier_ids": output["selected_supplier_ids"], "last_supplier_id": output["selected_supplier_ids"][-1]}
                transaction_core = {**preliminary, "completed_run_hash": delta["completed_run_hash"]}
                core = {"schema_version": JOURNAL_SCHEMA, "kind": "completion", "transaction_id": transaction_id, "transaction_core": transaction_core, "run_file": str(run_file), "state_file": str(state_file), "delta": delta}
                completion_dir, _ = transaction_dirs(state_file)
                journal_path = completion_dir / f"{run_file.stem}-{transaction_id}.json"
                if journal_path.exists():
                    validate_journal(load(journal_path), {"prepared", "run-written", "committed"}, "completion")
                else:
                    atomic_json(journal_path, journal_with_hash(core, "prepared"))
                if os.environ.get("RUN_STATE_FAIL_AFTER_PREPARE") == "1":
                    raise OSError("injected failure after durable prepare")
    journal = advance_completion_under_global(journal_path, state_file)
    print(json.dumps({"ok": True, "status": "completed", "completion_transaction_id": transaction_id, "phase": journal["phase"], "recovered_pending": recovered}))


def advance_completion_under_global(journal_path, state_file):
    with locked(Path(state_file).parent / ".daily-onboarding-state.lock"):
        return advance_completion(journal_path, state_file)


def assert_completed_consistent(run_file, state_file, run):
    validate_run(run, expected_run_id=run_file.stem)
    completion_dir, _ = transaction_dirs(state_file)
    matches = []
    for path in completion_dir.glob("*.json"):
        journal = validate_journal(load(path), {"prepared", "run-written", "committed"}, "completion")
        validate_completion_location(path, state_file, journal); validate_delta(journal)
        if journal.get("run_file") == str(run_file) and journal["phase"] == "committed":
            matches.append(journal)
    if len(matches) != 1 or run.get("completion_transaction_id") != matches[0]["transaction_id"]:
        raise ValueError("completed run lacks one matching committed journal")
    journal = matches[0]
    validate_delta(journal)
    with ExitStack() as stack:
        for batch in sorted(run["batches"]):
            stack.enter_context(locked(f"{batch_file(run_file, batch)}.lock"))
        rebuilt = merged_run(run_file, run)
    if sha(rebuilt["result_provenance"]) != journal["transaction_core"]["result_hash"] or sha(rebuilt["supplier_results"]) != journal["transaction_core"]["supplier_results_hash"]:
        raise ValueError("completed run diverges from latest batch evidence")
    if run.get("supplier_results") != rebuilt["supplier_results"] or run.get("result_provenance") != rebuilt["result_provenance"]:
        raise ValueError("completed canonical run/provenance mismatch")

def latest(args):
    run_file = validate_run_path(args.run_file)
    state_file = Path(args.state_file).absolute(); validate_state(load(state_file))
    with locked(state_file.parent / ".daily-onboarding-state.lock"):
        recover_pending_completions(state_file); recover_pending_imports(state_file)
        with locked(f"{run_file}.lock"):
            run = load(run_file); validate_run(run, expected_run_id=run_file.stem); batch = safe_slug(args.batch_id)
            with locked(f"{batch_file(run_file, batch)}.lock"):
                event = read_batch(run_file, run, batch)[0].get(args.supplier_id)
    print(json.dumps({"run_status": run["status"], "event": event} if event else {"run_status": run["status"], "event": None}, indent=2))


def status(args):
    run_file = validate_run_path(args.run_file)
    state_file = Path(args.state_file).absolute(); validate_state(load(state_file))
    pending = []
    with locked(state_file.parent / ".daily-onboarding-state.lock"):
        completion_dir, import_dir = transaction_dirs(state_file)
        for kind, directory in (("completion", completion_dir), ("recovery-import", import_dir)):
            phases = {"prepared", "run-written", "committed"} if kind == "completion" else {"prepared", "logs-written", "run-frozen", "committed"}
            for path in sorted(directory.glob("*.json")):
                journal = validate_journal(load(path), phases, kind)
                if kind == "completion":
                    validate_completion_location(path, state_file, journal); validate_delta(journal)
                else:
                    validate_import_location(path, journal)
                if journal["phase"] != "committed":
                    pending.append({"kind": kind, "file": str(path), "phase": journal["phase"], "transaction_id": journal["transaction_id"]})
        with locked(f"{run_file}.lock"):
            run = load(run_file)
            if run.get("plan_frozen"):
                validate_run(run, expected_run_id=run_file.stem)
                with ExitStack() as stack:
                    for batch in sorted(run["batches"]): stack.enter_context(locked(f"{batch_file(run_file, batch)}.lock"))
                    output = merged_run(run_file, run)
                summary = output["merge_summary"]
                if run["status"] == "completed":
                    related_pending = [item for item in pending if item["kind"] == "completion" and json.loads(Path(item["file"]).read_text()).get("run_file") == str(run_file)]
                    if related_pending:
                        journal = validate_journal(load(related_pending[0]["file"]), {"prepared", "run-written", "committed"}, "completion"); validate_delta(journal)
                        if sha(output["result_provenance"]) != journal["transaction_core"]["result_hash"] or sha(output["supplier_results"]) != journal["transaction_core"]["supplier_results_hash"]: raise ValueError("pending completed run diverges from batch evidence")
                    else:
                        assert_completed_consistent(run_file, state_file, run)
            else:
                validate_run(run, require_plan=False, expected_run_id=run_file.stem); selected = run.get("selected_supplier_ids", [])
                if run.get("legacy_completed") is True and run["status"] == "completed":
                    summary = {"result_count": len(run.get("supplier_results", {})), "missing_supplier_ids": [], "event_counts": {}, "legacy_completed": True, "canonical_log_verification": "unavailable-for-pre-v2.6-run"}
                else:
                    summary = {"result_count": len(run.get("supplier_results", {})), "missing_supplier_ids": selected, "event_counts": {}}
    legacy_ok = run.get("legacy_completed") is True and run["status"] == "completed"
    print(json.dumps({"status": run["status"], "plan_id": run.get("plan_id"), **summary, "pending_transactions": pending, "dispatch_blocked": bool(pending or summary["missing_supplier_ids"] or (not run.get("plan_frozen") and not legacy_ok))}, indent=2))

def validate_recovery_results(selected, results):
    if not isinstance(results, dict):
        raise ValueError("recovery results must be an object")
    expected = {str(item) for item in selected}
    if set(results) != expected or any(not DECIMAL_RE.fullmatch(key) for key in results):
        raise ValueError("recovery result keys must be exact canonical decimal selected IDs")
    for result in results.values():
        validate_result(result)
        if result["status"] != "final":
            raise ValueError("recovery results must all be final")


def ensure_import_authorization(state_file, run_id, manifest_path, evidence_path, create=False):
    state = validate_state(load(state_file)); selected = state["runs"].get(run_id, {}).get("selected_supplier_ids")
    expected = {"run_id": run_id, "manifest_path": str(Path(manifest_path).absolute()), "manifest_hash": file_sha(manifest_path), "evidence_path": str(Path(evidence_path).absolute()), "evidence_hash": file_sha(evidence_path), "selected_supplier_ids_hash": sha(selected)}
    authorizations = state.setdefault("recovery_import_authorizations", {}); existing = authorizations.get(run_id)
    if existing is None:
        if not create: raise ValueError("recovery import lacks canonical state authorization")
        authorizations[run_id] = expected; atomic_json(state_file, state); return expected
    if existing != expected: raise ValueError("recovery import request differs from canonical state authorization")
    return existing


def canonical_import_selected(state_file, run_id):
    state = validate_state(load(state_file)); source = state["runs"].get(run_id)
    selected = source.get("selected_supplier_ids") if isinstance(source, dict) else None
    if not isinstance(source, dict) or source.get("run_id") != run_id or source.get("status") != "running" or not isinstance(selected, list) or not selected:
        raise ValueError("recovery import requires a matching canonical running state entry")
    if any(type(item) is not int or item < 1 for item in selected) or len(selected) != len(set(selected)):
        raise ValueError("canonical state cohort is invalid")
    return selected


def build_import_core(run_file, state_file, manifest_path, evidence_path, imported_at, legacy_run):
    selected = canonical_import_selected(state_file, run_file.stem)
    ensure_import_authorization(state_file, run_file.stem, manifest_path, evidence_path, create=False)
    if legacy_run.get("run_id") not in {None, run_file.stem}: raise ValueError("legacy run payload run_id does not match physical file")
    if legacy_run.get("status") != "running" or legacy_run.get("plan_frozen") or legacy_run.get("batches") or legacy_run.get("selected_supplier_ids") != selected:
        raise ValueError("legacy run does not match canonical state cohort")
    manifest = load(manifest_path); plan = manifest.get("batches"); results = manifest.get("results")
    plan_id = validate_plan(selected, plan); validate_recovery_results(selected, results)
    synthetic = {**legacy_run, "supplier_results": results}; validate_evidence(evidence_path, synthetic)
    manifest_hash = file_sha(manifest_path); evidence_hash = file_sha(evidence_path)
    frozen_run = dict(legacy_run)
    frozen_run.update(run_id=run_file.stem, batches=plan, plan_frozen=True, plan_id=plan_id, recovery_import={"manifest": str(manifest_path), "manifest_sha256": manifest_hash, "evidence_manifest": str(evidence_path), "evidence_sha256": evidence_hash, "imported_at": imported_at})
    lines = {}
    for batch, supplier_ids in plan.items():
        batch_lines = []
        for supplier_id in supplier_ids:
            event = {"run_id": run_file.stem, "plan_id": plan_id, "batch_id": batch, "supplier_id": supplier_id, "sequence": 1, "recorded_at": imported_at, "result": results[str(supplier_id)], "recovery_evidence_reference": str(manifest_path)}
            event["event_id"] = sha(event); batch_lines.append(canonical(event) + "\n")
        lines[batch] = "".join(batch_lines)
    transaction_core = {"run_id": run_file.stem, "run_file": str(run_file), "state_file": str(state_file), "legacy_run_hash": sha(legacy_run), "legacy_had_run_id": "run_id" in legacy_run, "selected_supplier_ids": selected, "plan_id": plan_id, "frozen_run_hash": sha(frozen_run), "batch_lines_hash": sha(lines), "manifest_path": str(manifest_path), "manifest_hash": manifest_hash, "evidence_path": str(evidence_path), "evidence_hash": evidence_hash, "imported_at": imported_at}
    transaction_id = sha(transaction_core)
    return {"schema_version": JOURNAL_SCHEMA, "kind": "recovery-import", "transaction_id": transaction_id, "transaction_core": transaction_core, "run_file": str(run_file), "state_file": str(state_file), "frozen_run": frozen_run, "batch_lines": lines}


def import_journal_core(run_file, state_file, manifest_path, evidence_path, imported_at):
    return build_import_core(run_file, state_file, manifest_path, evidence_path, imported_at, load(run_file))


def legacy_payload_for_import_revalidation(journal, current):
    if journal["phase"] in {"prepared", "logs-written"}:
        return current
    if current != journal["frozen_run"]:
        raise ValueError("frozen recovery run differs from journal payload")
    legacy = dict(current)
    for key in ("batches", "plan_frozen", "plan_id", "recovery_import"):
        legacy.pop(key, None)
    if not journal["transaction_core"].get("legacy_had_run_id"):
        legacy.pop("run_id", None)
    return legacy


def revalidate_import_from_canonical(journal_path, journal, manifest_path, evidence_path, state_file):
    run_file = validate_import_location(journal_path, journal)
    manifest_path = Path(manifest_path).absolute(); evidence_path = Path(evidence_path).absolute(); state_file = Path(state_file).absolute()
    core = journal["transaction_core"]
    if journal.get("state_file") != str(state_file) or core.get("manifest_path") != str(manifest_path) or core.get("evidence_path") != str(evidence_path):
        raise ValueError("recovery import canonical path binding mismatch")
    current = load(run_file); legacy = legacy_payload_for_import_revalidation(journal, current)
    expected = build_import_core(run_file, state_file, manifest_path, evidence_path, core.get("imported_at"), legacy)
    for key in ("transaction_id", "transaction_core", "run_file", "state_file", "frozen_run", "batch_lines"):
        if journal.get(key) != expected.get(key): raise ValueError(f"recovery import canonical revalidation mismatch: {key}")
    return expected

def validate_import_location(journal_path, journal):
    run_file = validate_run_path(journal["run_file"])
    expected_parent = transaction_dirs(journal["state_file"])[1]
    expected_name = f"{run_file.stem}-{journal.get('transaction_id')}.json"
    if Path(journal_path).absolute().parent != expected_parent or Path(journal_path).name != expected_name:
        raise ValueError("import journal path/name binding mismatch")
    if journal["transaction_core"].get("run_id") != run_file.stem or journal.get("frozen_run", {}).get("run_id") != run_file.stem:
        raise ValueError("import journal run_id does not match physical run file")
    return run_file


def advance_import(journal_path, manifest_path=None, evidence_path=None, state_file=None, allow_injection=True):
    if manifest_path is None or evidence_path is None or state_file is None:
        raise ValueError("recovery import replay requires explicit canonical manifest, evidence and state paths")
    phases = {"prepared", "logs-written", "run-frozen", "committed"}
    journal = validate_journal(load(journal_path), phases, "recovery-import")
    revalidate_import_from_canonical(journal_path, journal, manifest_path, evidence_path, state_file)
    run_file = validate_import_location(journal_path, journal)
    if journal["transaction_core"].get("run_file") != journal["run_file"] or journal["transaction_core"].get("state_file") != journal["state_file"]:
        raise ValueError("import transaction path binding mismatch")
    if journal["transaction_id"] != sha(journal["transaction_core"]):
        raise ValueError("import transaction id mismatch")
    if sha(journal["frozen_run"]) != journal["transaction_core"]["frozen_run_hash"] or sha(journal["batch_lines"]) != journal["transaction_core"]["batch_lines_hash"]:
        raise ValueError("tampered import payload")
    root = Path(run_file).parent / "batch-results" / run_file.stem
    staging = Path(run_file).parent / "batch-results" / f".{run_file.stem}-{journal['transaction_id']}.staging"
    if journal["phase"] == "prepared":
        if staging.exists():
            no_symlinks(staging)
            shutil.rmtree(staging)
        safe_directory(staging.parent, create=True)
        safe_directory(staging, create=True)
        for batch, text in journal["batch_lines"].items():
            atomic_bytes(staging / f"{safe_slug(batch)}.jsonl", text.encode())
        if root.exists() or root.is_symlink():
            raise ValueError("recovery target batch root already exists")
        os.replace(staging, root)
        fsync_directory(root.parent)
        core = {key: value for key, value in journal.items() if key not in {"phase", "journal_hash"}}
        journal = journal_with_hash(core, "logs-written")
        atomic_json(journal_path, journal)
        if allow_injection and os.environ.get("RUN_STATE_FAIL_IMPORT_PHASE") == "logs-written":
            raise OSError("injected import failure after logs")
    revalidate_import_from_canonical(journal_path, journal, manifest_path, evidence_path, state_file)
    if journal["phase"] == "logs-written":
        current = load(run_file)
        if sha(current) != journal["transaction_core"]["legacy_run_hash"]:
            raise ValueError("legacy run changed during recovery import")
        atomic_json(run_file, journal["frozen_run"])
        core = {key: value for key, value in journal.items() if key not in {"phase", "journal_hash"}}
        journal = journal_with_hash(core, "run-frozen")
        atomic_json(journal_path, journal)
        if allow_injection and os.environ.get("RUN_STATE_FAIL_IMPORT_PHASE") == "run-frozen":
            raise OSError("injected import failure after run freeze")
    revalidate_import_from_canonical(journal_path, journal, manifest_path, evidence_path, state_file)
    if journal["phase"] == "run-frozen":
        core = {key: value for key, value in journal.items() if key not in {"phase", "journal_hash"}}
        journal = journal_with_hash(core, "committed")
        atomic_json(journal_path, journal)
    revalidate_import_from_canonical(journal_path, journal, manifest_path, evidence_path, state_file)
    return journal


def recover_pending_imports(state_file):
    _, import_dir = transaction_dirs(state_file); pending = []
    for path in sorted(import_dir.glob("*.json")):
        journal = validate_journal(load(path), {"prepared", "logs-written", "run-frozen", "committed"}, "recovery-import")
        validate_import_location(path, journal)
        if journal["phase"] != "committed": pending.append(path.name)
    if pending:
        raise ValueError(f"pending recovery import requires explicit import-recovery replay: {pending}")
    return []


def import_recovery(args):
    run_file = validate_run_path(args.run_file)
    state_file = Path(args.state_file).absolute()
    regular_file(state_file, "state file")
    manifest_path = Path(args.manifest).absolute()
    evidence_path = Path(args.evidence_manifest).absolute()
    regular_file(manifest_path, "recovery manifest")
    regular_file(evidence_path, "evidence manifest")
    imported_at = args.imported_at or timestamp()
    parse_timestamp(imported_at, "imported_at")
    with locked(state_file.parent / ".daily-onboarding-state.lock"):
        recover_pending_completions(state_file)
        canonical_import_selected(state_file, run_file.stem)
        ensure_import_authorization(state_file, run_file.stem, manifest_path, evidence_path, create=True)
        _, import_dir = transaction_dirs(state_file); matching = []; unrelated_pending = []
        for path in import_dir.glob("*.json"):
            journal = validate_journal(load(path), {"prepared", "logs-written", "run-frozen", "committed"}, "recovery-import"); validate_import_location(path, journal); core = journal["transaction_core"]
            same_request = journal.get("run_file") == str(run_file) and core.get("manifest_path") == str(manifest_path) and core.get("evidence_path") == str(evidence_path)
            if same_request:
                revalidate_import_from_canonical(path, journal, manifest_path, evidence_path, state_file); matching.append((path, journal))
            elif journal["phase"] != "committed": unrelated_pending.append(path.name)
        if unrelated_pending: raise ValueError(f"other pending recovery import blocks replay: {unrelated_pending}")
        if len(matching) > 1: raise ValueError("multiple recovery journals match this import")
        if matching:
            journal_path, journal = matching[0]
            if journal["phase"] == "committed":
                print(json.dumps({"ok": True, "transaction_id": journal["transaction_id"], "phase": "committed", "unchanged": True, "actions_performed": 0})); return
        else:
            core = import_journal_core(run_file, state_file, manifest_path, evidence_path, imported_at); journal_path = import_dir / f"{run_file.stem}-{core['transaction_id']}.json"; atomic_json(journal_path, journal_with_hash(core, "prepared"))
        journal = advance_import(journal_path, manifest_path, evidence_path, state_file)
    print(json.dumps({"ok": True, "transaction_id": journal["transaction_id"], "phase": journal["phase"], "actions_performed": 0}))


def main():
    parser = argparse.ArgumentParser()
    commands = parser.add_subparsers(dest="command", required=True)
    command = commands.add_parser("migrate-state-run-ids")
    command.add_argument("--state-file", required=True); command.add_argument("--runs-dir"); command.set_defaults(function=migrate_state_run_ids)
    command = commands.add_parser("freeze-plan")
    command.add_argument("--run-file", required=True); command.add_argument("--state-file", required=True); command.add_argument("--batch-plan", required=True); command.set_defaults(function=freeze_plan)
    command = commands.add_parser("append")
    command.add_argument("--run-file", required=True); command.add_argument("--state-file", required=True); command.add_argument("--batch-id", required=True); command.add_argument("--supplier-id", required=True, type=int); command.add_argument("--result-file", required=True); command.add_argument("--recorded-at"); command.add_argument("--correct", action="store_true"); command.add_argument("--reason"); command.add_argument("--evidence-reference"); command.set_defaults(function=append_result)
    command = commands.add_parser("merge")
    command.add_argument("--run-file", required=True); command.add_argument("--state-file", required=True); command.add_argument("--evidence-manifest"); command.add_argument("--complete", action="store_true"); command.add_argument("--completed-at"); command.set_defaults(function=merge)
    command = commands.add_parser("latest")
    command.add_argument("--run-file", required=True); command.add_argument("--state-file", required=True); command.add_argument("--batch-id", required=True); command.add_argument("--supplier-id", required=True, type=int); command.set_defaults(function=latest)
    command = commands.add_parser("status")
    command.add_argument("--run-file", required=True); command.add_argument("--state-file", required=True); command.set_defaults(function=status)
    command = commands.add_parser("import-recovery")
    command.add_argument("--run-file", required=True); command.add_argument("--state-file", required=True); command.add_argument("--manifest", required=True); command.add_argument("--evidence-manifest", required=True); command.add_argument("--imported-at"); command.set_defaults(function=import_recovery)
    args = parser.parse_args()
    try:
        args.function(args)
    except (OSError, ValueError, KeyError, json.JSONDecodeError) as error:
        parser.error(str(error))


if __name__ == "__main__":
    main()
