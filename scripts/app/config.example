# ---- Supabase: the app reads suppliers + inventory straight from Postgres ----
# Written into app/.env.local by scripts/app/secrets.sh. The secret key bypasses
# RLS and is only ever used server-side (app/lib/supabase.ts is `server-only`),
# so it must never be given a NEXT_PUBLIC_ prefix.
SUPABASE_URL=            # https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=     # sb_secret_... (Project settings → API keys)

# ---- artifacts: which agents may publish pages on $DOMAIN ----
# Comma-separated agent ids. scripts/app/secrets.sh generates one shared
# ARTIFACTS_APP_SECRET, writes it to each agent's bucket in
# harness/.secrets/secrets.json, and passes the list to the app as
# ARTIFACTS_AGENTS — the app 404s any agent not named here.
#
# Leave the harness-owned ARTIFACTS_AGENT (singular, in ../../config.example)
# BLANK: it wires only one agent and would overwrite the committed per-agent
# plugin config.json with a domain-root appBaseUrl.
#
# Adding an agent: add it here, create
# harness/agents/<agent>/plugins/artifacts/config.json with
# {"appBaseUrl":"https://$DOMAIN/a/<agent>"}, then `server.sh restart`.
ARTIFACTS_AGENTS=daisy,nova

# ---- app sign-in ----
# The app owns its own sign-in as of 2026-08-30 (Supabase Auth; see
# app/lib/auth.ts). **No app credential lives in `config`.** Internal accounts
# are created directly in Supabase — an auth user plus its `app_users` row
# (docs/app/README.md, *Auth*) — and partner logins are made from the supplier
# page. Nothing bootstraps an admin out of a config value.
#
# Not to be confused with the harness-owned APP_USER/APP_PASS in
# ../../config.example, which are the *harness console's* operator login on
# port 3142. The two sign-ins are unrelated.

# Supabase Auth identifies a user by email, this app by a username, so the
# email is derived: a typed address is used as-is, anything else becomes
# <username>@AUTH_EMAIL_DOMAIN. These mailboxes do not exist and are never
# written to — keep the `.invalid` TLD (RFC 2606) so nothing can be.
AUTH_EMAIL_DOMAIN=lps-app.invalid
