# One-time AWS provisioning params. Copy to `aws-config` and edit:
#   cp aws-config.example aws-config
# Sourced by setup-aws.sh (plain shell, no spaces around =).

AWS_PROFILE=             # optional named aws-cli profile (blank = default creds)
AWS_REGION=us-east-1

S3_BUCKET=rosie-backups          # bucket to create (also the IAM role's read/write scope)
EC2_NAME=rosie-server            # EC2 Name tag; also used for the security group + IAM role names
EC2_TYPE=t3.medium               # instance type
EC2_DISK_GB=20                   # root EBS volume size in GB (gp3)
UBUNTU_VERSION=26.04             # Ubuntu release (latest AMI via SSM), e.g. 24.04, 26.04
EIP_NAME=rosie-ip                # Elastic IP Name tag
KEY_NAME=rosie-key               # key pair name; private key saved to ~/.ssh/<name>.pem
IAM_ROLE=                        # blank = <EC2_NAME>-role
SSH_HOST_ALIAS=rosie             # `Host` entry written to ~/.ssh/config (ssh <alias>)
SSH_OPEN=false                   # true = port 22 from anywhere; false = only this machine's IP
GIT_REPO=                        # repo to clone on the box (blank = this repo's origin)
